# Copia este archivo a backend/.env. NO guardes secretos reales en el repositorio.
# Una variable vacía cuenta como "no definida" (no pisa a una real).

# --- Servidor ---
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# --- Datos (SQLite local; persisten entre reinicios) ---
# DB_PATH=./data/enruta.sqlite
# STORAGE_DIR=./storage

# --- Red local / QR: URL con la que un teléfono abre la web (usa la IP de tu PC, no localhost) ---
PUBLIC_WEB_URL=http://localhost:4200
# CORS_ORIGINS=http://192.168.1.50:4200
COOKIE_SECURE=false
# URL pública de la API (la usa el QR para el contrato móvil). Con la IP de tu red local, p. ej. http://192.168.1.50:3000
# PUBLIC_API_URL=http://localhost:3000

# --- Seguridad ---
# Obligatoria en producción (cifra el secreto 2FA). En desarrollo hay un valor de ejemplo.
DATA_ENCRYPTION_KEY=
BCRYPT_COST=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
RESET_TOKEN_MINUTES=15
# RESET_COOLDOWN_SECONDS=60           # espera mínima entre dos solicitudes de recuperación de la misma cuenta
# LOGIN_MAX_PER_IP_15MIN=20           # intentos de acceso por IP en 15 min
# RATE_LIMIT=true                     # limitadores por IP; las pruebas automáticas lo apagan
# SESSION_IDLE_MINUTES=720            # inactividad que cierra la sesión
# SESSION_MAX_DAYS=7                  # vida máxima de una sesión «recordada»
# SESSION_SHORT_HOURS=12              # vida de una sesión sin «recordarme»

# --- Correo: local = bandeja de desarrollo (GET /api/dev/mailbox, vista /dev/correo) | smtp ---
MAIL_MODE=local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# SMTP_SECURE=                        # true = TLS directo; vacío = TLS directo solo si el puerto es 465

# --- Validación de RFC: local (simulada, determinista) | idoo (consulta real o sandbox del proveedor) ---
RFC_MODE=local
IDOO_API_KEY=
# IDOO_BASE_URL=https://idoo.dev/v1/valida-rfc
# IDOO_TIMEOUT_MS=30000               # tiempo máximo de la consulta al proveedor
# IDOO_MAX_RETRIES=1                  # reintentos ante fallos transitorios
# RFC_VALIDATION_TTL_SECONDS=1800     # vigencia del resultado de validación para completar el registro
# RFC_LOCAL_TIMEOUT_MS=300            # modo local: duración del timeout simulado (RFC que empieza por TMO)

# --- Timbrado Carta Porte: local (simulado, sin UUID fiscal) | live ---
PAC_MODE=local
# PAC_API_URL=
# PAC_API_TOKEN=
# PAC_LOCAL_TIMEOUT_MS=200            # modo local: duración del timeout simulado (folio que empieza por TMO-)
# Modo local determinista: folios REJ-… (rechazo), ERR-… (error con reintentos) y TMO-… (timeout); otro = «Simulado» (sin UUID fiscal)

# --- Cola de trabajos (SQLite, sin Redis) ---
# QUEUE_POLL_MS=1000
# QUEUE_LEASE_SECONDS=60
# QUEUE_MAX_ATTEMPTS=5

# --- GPS y simulador (torre de control) ---
# Un dato REAL/SIMULADO es «reciente» hasta GPS_STALE_SECONDS; luego «Desactualizado» hasta GPS_OFFLINE_SECONDS; después «Desconectado».
GPS_STALE_SECONDS=120
GPS_OFFLINE_SECONDS=900
# El simulador genera posiciones marcadas como SIMULADAS. Por defecto activo fuera de producción.
# SIMULATOR_ENABLED=true
SIMULATOR_STEP_SECONDS=5

# --- Mapas (token público pk.* de Mapbox; restringe su uso por URL en tu cuenta de Mapbox) ---
MAPBOX_PUBLIC_TOKEN=
